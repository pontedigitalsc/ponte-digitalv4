# ─── SUPABASE ───────────────────────────────────────────────
# URL do projeto Supabase (Dashboard > Settings > API > Project URL)
NEXT_PUBLIC_SUPABASE_URL=https://seu-projeto.supabase.co

# Chave anônima pública do Supabase (Dashboard > Settings > API > anon public)
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-chave-anon-publica

# Service Role Key do Supabase — NUNCA expor ao frontend (Dashboard > Settings > API > service_role)
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# ─── BANCO ──────────────────────────────────────────────────
# Conexão pooled (porta 6543) — usada pela aplicação em runtime
DATABASE_URL=postgresql://usuario:senha@host:6543/postgres

# Conexão direta (porta 5432) — usada pelo Prisma CLI para migrations no deploy
DIRECT_URL=postgresql://usuario:senha@host:5432/postgres

# ─── APP ────────────────────────────────────────────────────
# URL pública da aplicação (produção = URL da Vercel, ex: https://ponte-digitalv4.vercel.app)
NEXT_PUBLIC_APP_URL=https://seu-app.vercel.app

# ─── IA (Google Gemini — padrão) ────────────────────────────
# Provider ativo: google (padrão) | groq | anthropic | noop
AI_PROVIDER=google

# Chave da API Google Gemini (gratuita em https://aistudio.google.com/apikey)
GOOGLE_API_KEY=sua-chave-gemini

# Modelo usado pelo provider ativo (opcional — cada provider tem fallback)
AI_MODEL=gemini-2.5-flash

# ─── IA (demais providers — opcionais, apenas se AI_PROVIDER for alterado) ──
# GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# ─── SEED (apenas desenvolvimento — remover após seed executado) ────────────
# SEED_ADMIN_EMAIL=admin@empresa.com
# SEED_ADMIN_PASSWORD=senha-segura-aqui
